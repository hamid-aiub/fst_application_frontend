# Copy this file to .env.docker and adjust the public URL for the backend.
APP_IMAGE=fst-frontend:local
FRONTEND_HOST_PORT=3000

# Used by server-side Next.js routes to reach the backend over the shared Docker network.
API_BASE_URL=http://api:5001

# Production runs behind HTTPS, so session cookies must be secure.
AUTH_COOKIE_SECURE=true

# Used by browser-side profile image URLs. Set to the backend URL reachable by visitors,
# or your public HTTPS API domain when one is configured.
NEXT_PUBLIC_API_BASE_URL=http://20.235.244.139:5001
